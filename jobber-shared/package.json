{
  "version": "0.3.4",
  "license": "MIT",
  "name":"@manikandanr2023/jobber-shared",
  "main":"build/src/index.js",
  "types": "./build/src/index.d.ts",

  "description": "Helpers library for Jobber app",
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && tsc --outDir build/src && node scripts/build-package.js",
    "build:cjs": "cross-env NODE_ENV=production BABEL_ENV=cjs babel src --presets=./scripts/babel-preset.js --extensions .ts,.tsx --ignore src/**/*.specs.tsx --out-dir build/cjs --source-maps",
    "build:esm": "cross-env NODE_ENV=production BABEL_ENV=esm babel src --presets=./scripts/babel-preset.js --extensions .ts,.tsx --ignore src/**/*.specs.tsx --out-dir build/esm --source-maps"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "keywords": [],
  "name": "@manikandanr2023/jobber-shared",
  "author": "Manikandan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manikandanr2023/jobber-shared.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "build",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    }
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.4.2",
    "cloudinary": "^2.10.0",
    "elastic-apm-node": "^3.49.1",
    "express": "^5.2.1",
    "flatbuffers": "^24.3.25",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "winston": "^3.19.0",
    "winston-elasticsearch": "^0.17.4"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3"
  }
}
