{
  "name": "jobber-gigs",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start": "pm2 start ./build/src/app.js -i 5 --attach --watch | pino-pretty -c",
    "stop": "pm2 stop all",
    "delete": "pm2 delete all",
    "dev": "nodemon -r tsconfig-paths/register src/app.ts | pino-pretty -c",
    "lint:check": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "prettier:check": "prettier --check  'src/**/*.{ts,json}'",
    "prettier:fix": "prettier --write 'src/**/*.{ts,json}'",
    "build": "tsc --project  tsconfig.json && tsc-alias -p tsconfig.json ",
    "test": "jest --coverage=true -w=1 --forceExit --detectOpenHandles --watchAll=false"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.4.2",
    "@faker-js/faker": "^10.5.0",
    "@jest/types": "^30.4.1",
    "@manikandanr2023/jobber-shared": "^0.3.4",
    "@types/amqplib": "^0.10.8",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "elastic-apm-node": "^4.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "http-status-code": "^2.1.0",
    "jest": "^30.4.2",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "redis": "^6.2.0",
    "ts-alias": "^0.0.7",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-transform-paths": "^4.0.0",
    "uuid": "^14.0.1",
    "uuidv4": "^6.2.13",
    "winston": "^3.19.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
